config 9router-go 'main'
	option enabled '1'
	# Port the gateway listens on. The dashboard is served from the same port.
	option port '20130'
	# Empty binds every address (IPv4 + IPv6). Set to 127.0.0.1 to keep the
	# dashboard off the LAN and reach it through a tunnel only.
	option host ''
	# Must live on writable storage: the SQLite database, the downloaded
	# cloudflared binary and the runtime copy of 9router-go all sit here.
	# sysupgrade keeps $data_dir/db and $data_dir/uploads across a flash that
	# keeps settings, through /lib/upgrade/keep.d/9router-go. A non-default
	# path is added to /etc/sysupgrade.conf by postinst. /tmp is never kept.
	option data_dir '/opt/9router'
	# 0: updates arrive through `opkg upgrade` only (recommended, the package
	# owns the version). 1: the binary also checks GitHub and replaces its own
	# runtime copy under data_dir/bin.
	option auto_update '0'
	option log_level 'info'
	# Filled once by postinst with a random secret; empty means the gateway
	# generates its own each start, which invalidates dashboard sessions.
	option jwt_secret ''
	# Periodically probe /health and restart the gateway if it stays wedged.
	# The probe is installed as a cron job; 0 disables it.
	option healthcheck '1'
	# Consecutive failed probes before a restart, and the per-probe timeout in
	# seconds. One failure is a busy box; a run of them means the listener is
	# dead.
	option healthcheck_threshold '3'
	option healthcheck_timeout '5'
	# Open a LAN firewall rule for the gateway so the dashboard can be
	# reached from the LAN when `host` binds every address. 0 leaves LAN
	# access closed; operators open it deliberately.
	option open_lan '0'
