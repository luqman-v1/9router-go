config 9router-go 'main'
	option enabled '1'
	# Port the gateway listens on. The dashboard is served from the same port.
	option port '20130'
	# Empty binds every address (IPv4 + IPv6). Set to 127.0.0.1 to keep the
	# dashboard off the LAN and reach it through a tunnel only.
	option host ''
	# Must live on writable storage: the SQLite database, the downloaded
	# cloudflared binary and the runtime copy of 9router-go all sit here.
	# /opt survives a sysupgrade that keeps settings; /tmp does not.
	option data_dir '/opt/9router'
	# 0: updates arrive through `opkg upgrade` only (recommended, the package
	# owns the version). 1: the binary also checks GitHub and replaces its own
	# runtime copy under data_dir/bin.
	option auto_update '0'
	option log_level 'info'
	# Filled once by postinst with a random secret; empty means the gateway
	# generates its own each start, which invalidates dashboard sessions.
	option jwt_secret ''
