#!/bin/sh
# 9router-go-backup — save or restore the gateway database.
#
# A router is flashed far more often than a server is rebuilt, and the SQLite
# file holds every provider connection, combo and API key. This writes a
# consistent copy by stopping the gateway first: copying a live SQLite file can
# capture a half-written page, and `sqlite3` is not installed on most images.
#
#   9router-go-backup save [file]     default: /etc/9router-go/backup/data.sqlite
#   9router-go-backup restore [file]
#   9router-go-backup list
#
# /etc/9router-go is listed in this package's keep.d drop-in, so the default
# backup location survives a firmware upgrade that keeps settings.
#
# Requires OpenWrt 18.06 or later. Only busybox applets are used: no pgrep (left
# out of many 18.06 builds), no sqlite3, no gzip.

set -e

STATE_DIR=/etc/9router-go
BACKUP_DIR="$STATE_DIR/backup"
DEFAULT_FILE="$BACKUP_DIR/data.sqlite"
PIDFILE=/var/run/9router-go.pid

data_dir=$(uci -q get 9router-go.main.data_dir 2>/dev/null)
data_dir=${data_dir:-/opt/9router}
db="$data_dir/db/data.sqlite"

service_running() {
	[ -f "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	[ -n "$pid" ] || return 1
	# kill -0 tests liveness without signalling. A stale pid file naming a
	# reused PID would return success here, but the consequence is only that
	# the service is started again after the copy, and procd refuses to start an
	# already-running instance.
	kill -0 "$pid" 2>/dev/null
}

stop_service() { /etc/init.d/9router-go stop >/dev/null 2>&1 || true; }
start_service() { /etc/init.d/9router-go start >/dev/null 2>&1 || true; }

file_size() {
	if command -v du >/dev/null 2>&1; then
		du -h "$1" 2>/dev/null | cut -f1
	else
		echo "$(wc -c < "$1") bytes"
	fi
}

do_save() {
	out="${1:-$DEFAULT_FILE}"
	mkdir -p "$(dirname "$out")"
	if [ ! -f "$db" ]; then
		echo "9router-go-backup: no database at $db" >&2
		exit 1
	fi
	was_running=0
	service_running && was_running=1
	stop_service
	if ! cp -f "$db" "$out"; then
		[ "$was_running" -eq 1 ] && start_service
		echo "9router-go-backup: copy to $out failed (out of space?)" >&2
		exit 1
	fi
	# The database is not the only user state: uploaded logos and other media
	# live under data_dir/uploads, and a restore onto a new router without them
	# leaves the dashboard pointing at files that are not there. The archive is
	# written beside the database so the existing `save <file>` argument keeps
	# its meaning. tar is a busybox applet present in every image this package
	# targets; when it is missing, the media is skipped and said so rather than
	# failing the whole backup.
	uploads="$data_dir/uploads"
	arch="$out.uploads.tar"
	if [ -d "$uploads" ] && [ -n "$(ls -A "$uploads" 2>/dev/null)" ]; then
		if command -v tar >/dev/null 2>&1; then
			# -C keeps both paths literal: no cd means a relative `out` keeps
			# its meaning, and no path juggling is needed for drive-letter or
			# symlinked data_dir values.
			if tar -C "$data_dir" -cf "$arch" uploads 2>/dev/null; then
				echo "9router-go-backup: saved uploads ($(file_size "$arch")) to $arch"
			else
				rm -f "$arch"
				echo "9router-go-backup: could not archive $uploads, database saved without media" >&2
			fi
		else
			echo "9router-go-backup: tar not found, media in $uploads not backed up" >&2
		fi
	fi
	[ "$was_running" -eq 1 ] && start_service
	echo "9router-go-backup: saved $(file_size "$out") to $out"
}

do_restore() {
	in="${1:-$DEFAULT_FILE}"
	[ -f "$in" ] || { echo "9router-go-backup: $in not found" >&2; exit 1; }
	mkdir -p "$data_dir/db"
	was_running=0
	service_running && was_running=1
	stop_service
	# Keep the replaced file: a restore from the wrong backup must be undoable
	# on a device with no other copy.
	[ -f "$db" ] && cp -f "$db" "$db.before-restore"
	if ! cp -f "$in" "$db"; then
		[ "$was_running" -eq 1 ] && start_service
		echo "9router-go-backup: restore from $in failed" >&2
		exit 1
	fi
	# Restore the media archive written by `save`, when there is one. Extracting
	# over the existing directory keeps files the archive does not carry, which
	# is what an operator restoring an older database expects.
	arch="$in.uploads.tar"
	if [ -f "$arch" ] && command -v tar >/dev/null 2>&1; then
		mkdir -p "$data_dir"
		if tar -C "$data_dir" -xf "$arch" 2>/dev/null; then
			echo "9router-go-backup: restored uploads from $arch"
		else
			echo "9router-go-backup: could not restore $arch, database restored without media" >&2
		fi
	fi
	[ "$was_running" -eq 1 ] && start_service
	echo "9router-go-backup: restored $in (previous database kept as $db.before-restore)"
}


do_list() {
	if [ -d "$BACKUP_DIR" ]; then
		ls -l "$BACKUP_DIR"
	else
		echo "9router-go-backup: no backups in $BACKUP_DIR"
	fi
}

case "$1" in
	save) shift; do_save "$@" ;;
	restore) shift; do_restore "$@" ;;
	list) do_list ;;
	*)
		echo "usage: 9router-go-backup {save [file] | restore [file] | list}" >&2
		exit 1
		;;
esac
