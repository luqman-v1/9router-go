#!/bin/sh
# prerm — stop the service before its files disappear, so no orphan daemon holds
# the port after a clean removal.
#
# `opkg upgrade` calls this with "upgrade" as the argument. Replacing files is
# atomic (postinst installs the runtime copy with mv), so the old process can
# keep running until the new one is started; stopping it here would drop
# in-flight proxied requests for no benefit.

[ -n "$IPKG_INSTROOT" ] && exit 0

[ "$1" = "upgrade" ] && exit 0

/etc/init.d/9router-go stop 2>/dev/null
/etc/init.d/9router-go disable 2>/dev/null

# Remove the health probe's cron entry. Rewrite rather than deleting the
# whole file; this preserves jobs the operator added for other purposes.
if [ -d /etc/crontabs ] && [ -f /etc/crontabs/root ]; then
	tmp=/etc/crontabs/root.9router-go.tmp
	grep -v '/usr/bin/9router-go-healthcheck' /etc/crontabs/root > "$tmp" 2>/dev/null || true
	mv -f "$tmp" /etc/crontabs/root
	/etc/init.d/cron restart >/dev/null 2>&1 || true
fi

# Remove the LAN firewall rule the init script installed.
if command -v uci >/dev/null 2>&1 && uci -q get firewall >/dev/null 2>&1; then
	rule="9router-go-allow-lan"
	idx=$(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='$rule'$/\1/p" | head -1)
	if [ -n "$idx" ]; then
		uci -q delete firewall.$idx
		uci -q commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
		logger -t 9router-go "removed the LAN firewall rule"
	fi
fi

exit 0
