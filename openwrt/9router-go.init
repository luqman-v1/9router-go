#!/bin/sh /etc/rc.common
# procd service for 9router-go.
#
# Written for OpenWrt 18.06 and later: nothing here needs a procd or rc.common
# feature newer than that. In particular `respawn` is given the two-argument
# form (threshold, timeout) because the third `retry` argument only exists in
# procd builds new enough for 19.07; with two arguments procd keeps restarting
# at `timeout` intervals, which is the behaviour 18.06 scripts have.

START=99
STOP=10
USE_PROCD=1

NAME=9router-go
PROG=/usr/bin/$NAME
HEALTHCHECK=/usr/bin/9router-go-healthcheck
PIDFILE=/var/run/$NAME.pid
RULE_NAME=9router-go-allow-lan

start_service() {
	local enabled port host data_dir auto_update jwt_secret log_level healthcheck open_lan

	config_load "$NAME"
	config_get_bool enabled main enabled 1
	config_get port main port '20130'
	config_get host main host ''
	config_get data_dir main data_dir '/opt/9router'
	config_get_bool auto_update main auto_update 0
	config_get jwt_secret main jwt_secret ''
	config_get_bool healthcheck main healthcheck 1
	config_get_bool open_lan main open_lan 0

	if [ "$enabled" -ne 1 ]; then
		logger -t "$NAME" "disabled in /etc/config/$NAME, not starting"
		return 0
	fi

	if ! mkdir -p "$data_dir/db"; then
		logger -t "$NAME" "cannot create $data_dir, refusing to start"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG"
	procd_set_param env DATA_DIR="$data_dir"
	procd_set_param env PORT="$port"
	procd_set_param env LOG_LEVEL="$log_level"
	if [ "$auto_update" -eq 1 ]; then
		procd_set_param env AUTO_UPDATE="true"
	else
		procd_set_param env AUTO_UPDATE="false"
	fi
	if [ -n "$host" ]; then
		procd_set_param env HOST="$host"
	fi
	if [ -n "$jwt_secret" ]; then
		procd_set_param env JWT_SECRET="$jwt_secret"
	fi
	# The pid file is the one liveness signal shared by procd, the LuCI page and
	# the backup helper. It is written by the launcher, not by
	# `procd_set_param pidfile`: that parameter does not exist in every procd
	# release this package supports (18.06 predates it), and passing an unknown
	# parameter makes procd.sh complain on every boot.
	procd_set_param env NINE_ROUTER_PIDFILE="$PIDFILE"
	# respawn <threshold> <timeout>: the third `retry` argument only exists in
	# procd builds from 19.07 onward, so it is not passed. With two arguments
	# procd restarts at `timeout` intervals, which is what 18.06 scripts do.
	procd_set_param respawn 3600 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The probe is a separate script; cron must never invoke $PROG, which is
	# the gateway wrapper itself. Rewrite rather than append so a repeated
	# start does not stack duplicate lines, and drop the entry when the
	# operator turned healthcheck off.
	if [ -d /etc/crontabs ]; then
		tmp=/etc/crontabs/root.9router-go.tmp
		grep -vF "$HEALTHCHECK" /etc/crontabs/root > "$tmp" 2>/dev/null || true
		if [ "$healthcheck" -eq 1 ]; then
			printf '* * * * * %s\n' "$HEALTHCHECK" >> "$tmp"
		fi
		mv -f "$tmp" /etc/crontabs/root
		/etc/init.d/cron restart >/dev/null 2>&1 || true
	fi

	# Open the LAN rule after the instance is configured, so a firewall rule
	# never exists without a running gateway behind it.
	if [ "$open_lan" -eq 1 ]; then
		firewall_allow_lan "$port"
	fi

	logger -t "$NAME" "started on port $port, data in $data_dir"
}

stop_service() {
	# No work here: procd stops the instance itself. The LAN rule is owned by
	# the operator's open_lan setting and by prerm, not by a transient stop,
	# so a `stop; start` cycle keeps the rule and a boot with open_lan=0
	# removes it on the next start.
	return 0
}

# firewall_allow_lan creates an idempotent uci-firewall rule for the gateway
# port. It is called from start_service when open_lan is set; the rule is named
# so prerm and a later open_lan=0 can remove exactly it.
firewall_allow_lan() {
	port="${1:-20130}"
	command -v uci >/dev/null 2>&1 || return 0
	uci -q get firewall >/dev/null 2>&1 || return 0
	# Idempotent: re-running after a restart must not create a second rule.
	if uci -q get firewall.$RULE_NAME >/dev/null 2>&1; then
		# The rule exists but may point at a stale port; keep it in sync.
		uci -q set firewall.$RULE_NAME.dest_port="$port" >/dev/null 2>&1
		uci -q commit firewall >/dev/null 2>&1
		return 0
	fi
	uci -q add firewall rule >/dev/null 2>&1 || return 0
	uci -q set firewall.@rule[-1].name="$RULE_NAME" >/dev/null 2>&1
	uci -q set firewall.@rule[-1].src="lan" >/dev/null 2>&1
	uci -q set firewall.@rule[-1].proto="tcp udp" >/dev/null 2>&1
	uci -q set firewall.@rule[-1].dest_port="$port" >/dev/null 2>&1
	uci -q set firewall.@rule[-1].target="ACCEPT" >/dev/null 2>&1
	uci -q set firewall.@rule[-1].enabled="1" >/dev/null 2>&1
	uci -q commit firewall >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1 || true
	logger -t "$NAME" "opened port $port on the LAN firewall"
}

# firewall_disallow_lan removes the rule by name. uci section names are not
# stable across config loads, so it matches the name field rather than an index.
firewall_disallow_lan() {
	command -v uci >/dev/null 2>&1 || return 0
	uci -q get firewall >/dev/null 2>&1 || return 0
	idx=$(uci -q show firewall | sed -n "s/^firewall\.\([^.]*\)\.name='$RULE_NAME'$/\1/p" | head -1)
	if [ -n "$idx" ]; then
		uci -q delete firewall.$idx >/dev/null 2>&1
		uci -q commit firewall >/dev/null 2>&1
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
		logger -t "$NAME" "closed the LAN firewall rule"
	fi
}

reload_service() {
	stop
	start
}

# Reload the service when its UCI file changes, so `uci commit` followed by
# `reload_config` picks up a port change without a manual restart. This is not
# what makes an upgrade take effect: `opkg upgrade` only replaces files and the
# running process keeps the old inode, so postinst restarts the service itself.
service_triggers() {
	procd_add_reload_trigger "$NAME"
}
